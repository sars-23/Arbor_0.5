fun makeCounter() {
    let count = 0;

    fun increment() {
        count = count + 1;
        return count;
    }

    return increment;
}

let counter1 = makeCounter();
let counter2 = makeCounter();

print("Counter 1:");
print(counter1());
print(counter1());
print(counter1());

print("Counter 2:");
print(counter2());
